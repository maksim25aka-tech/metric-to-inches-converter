import java.util.Scanner;

public class Converter {
    public static void main(String[] args) {
        System.out.println("=== Metric to Inches Converter (Java) ===");
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter unit (cm/m): ");
        String unit = sc.nextLine().trim().toLowerCase();
        System.out.print("Enter value: ");
        double value = sc.nextDouble();
        double result;
        if (unit.equals("cm")) result = value / 2.54;
        else if (unit.equals("m")) result = value * 39.3700787;
        else {
            System.out.println("Error: unknown unit.");
            sc.close();
            return;
        }
        System.out.printf("%.4f %s = %.4f inches%n", value, unit, result);
        sc.close();
    }
}
